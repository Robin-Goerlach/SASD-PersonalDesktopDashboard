<Application x:Class="Sasd.PersonalDesktopDashboard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Central color resources for the first SASD dark theme. -->
    <SolidColorBrush x:Key="SasdBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SasdPanelBrush" Color="#172033" />
    <SolidColorBrush x:Key="SasdPanelSoftBrush" Color="#1F2A44" />
    <SolidColorBrush x:Key="SasdAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SasdAccentSoftBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="SasdTextBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SasdMutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SasdBorderBrush" Color="#334155" />
  </Application.Resources>
</Application>
